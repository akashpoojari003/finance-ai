# Copy to infra/.env and replace every value. Never commit infra/.env.

# ---------- Database ----------
# IDE run uses localhost; Docker Compose overrides this with the postgres container.
DB_URL=jdbc:postgresql://localhost:5432/financeai
DB_USER=dummy_db_user
DB_PASS=dummy_db_password

# ---------- Security ----------
# Base64 of at least 32 random bytes, e.g. openssl rand -base64 48
# Intentionally invalid: the app refuses to start until you replace it.
JWT_SECRET=REPLACE_ME_base64_of_32_plus_random_bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:5173
CRON_TOKEN=dummy_cron_token_replace_me
PROMETHEUS_TOKEN=dummy_prometheus_token_replace_me

# ---------- Mail (Gmail SMTP) ----------
MAIL_USER=dummy.user@example.com
MAIL_APP_PASSWORD=dummy_app_password

# ---------- AI ----------
GEMINI_API_KEY=dummy_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ---------- WhatsApp (Twilio) ----------
WHATSAPP_ENABLED=false
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=dummy_twilio_auth_token
TWILIO_FROM=+10000000000

# ---------- Alerts ----------
ALERTS_SCHEDULER_ENABLED=true

# ---------- Monitoring ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dummy_grafana_password

# ---------- Deploy ----------
DOCKERHUB_USER=dummy_dockerhub_user
FRONTEND_PORT=80